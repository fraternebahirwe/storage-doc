# PostgreSQL connection string
DATABASE_URL="postgresql://username@localhost:5432/storage_doc_dev"

# Server
PORT=4100
NODE_ENV=development

# URL of the frontend, used for CORS and building links (e.g. password reset)
CLIENT_URL="http://localhost:5183"

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="storage_doc_token"

# File storage: "local" (default, no account needed) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Only read when STORAGE_DRIVER="s3" (works for AWS S3, Supabase Storage,
# Cloudinary's S3-compatible endpoint, or any S3-compatible provider)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Default per-user storage limit, in bytes (10 GB)
DEFAULT_STORAGE_LIMIT_BYTES=10737418240
